---
layout: "base.njk"
pagination:
    data: collections.snippets
    size: 1
    alias: snippet
permalink: "/snippets/{{ snippet.category }}/{{ snippet.slug }}/index.html"
eleventyComputed:
    title: "{{ snippet.title }}"
---

<div class="mx-auto w-full max-w-6xl rounded-3xl border border-white/10 bg-gradient-to-br from-[#1A1D29] via-[#151821] to-[#0F1117] p-6 sm:p-10 card-grainy relative isolate shadow-glow">
    <div class="pointer-events-none absolute top-0 left-0 h-96 w-96 rounded-full bg-blue-500/5 blur-3xl"></div>

    <!-- Header -->
    <div class="relative mb-8">
        <a href="/" class="text-sm text-cyan-400 hover:text-cyan-300 transition-colors">&larr; Back to Collection</a>
        <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">{{ snippet.title }}</h1>
        <p class="mt-2 text-gray-400">{{ snippet.description }}</p>
        <div class="mt-4 flex flex-wrap gap-2">
            {%- for tag in snippet.tags -%}
                <span class="rounded bg-cyan-500/10 px-2 py-0.5 text-xs font-medium text-cyan-400">{{ tag }}</span>
            {%- endfor -%}
        </div>
    </div>

    <!-- Live Preview (only for HTML snippets) -->
    {%- if snippet.codeFile.endsWith('.html') -%}
    <div class="mb-8">
        <h2 class="text-lg font-semibold text-white mb-4">Live Preview</h2>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
             <iframe srcdoc="{{ snippet | readFile | escape }}" class="h-[400px] w-full rounded-lg bg-white"></iframe>
        </div>
    </div>
    {%- endif -%}

    <!-- Source Code -->
    <div>
        <div class="flex justify-between items-center mb-4">
             <h2 class="text-lg font-semibold text-white">Source Code ({{ snippet.codeFile }})</h2>
             <button id="copy-button" class="rounded-lg bg-gray-700/50 px-4 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 transition-colors">Copy Code</button>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black/30 p-4">
            <pre class="overflow-x-auto p-4 text-sm"><code id="code-block" class="language-{{ snippet.codeFile.split('.').pop() }}">{{ snippet | readFile | escape }}</code></pre>
        </div>
    </div>
</div>